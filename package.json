{
  "name": "rocketlane-status-email",
  "version": "1.0.0",
  "description": "Daily project status email for blocked/delayed Rocketlane projects",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "upload-template": "ts-node scripts/upload-template.ts",
    "deploy": "npm run build && sam deploy",
    "local-run": "ts-node local/run.ts",
    "local-debug": "ts-node local/debug.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-ses": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "axios": "^1.7.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
