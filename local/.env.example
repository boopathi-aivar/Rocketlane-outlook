# Copy this file to local/.env and fill in your values.
# local/.env is gitignored — never commit real credentials.

# Required — your Rocketlane API key
ROCKETLANE_API_KEY=your_rocketlane_api_key_here

# Optional — defaults shown below
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0
DAY_THRESHOLD=7
